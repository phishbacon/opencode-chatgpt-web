# Copy to .env (git-ignored) and fill in machine-local values.

# OpenAI tunnel id the website MCP runtime connects under (alias is derived
# from the profile name inside the container).
TUNNEL_ID=tunnel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host interfaces to publish the noVNC login/maintenance view on
# (e.g. your LAN IP and your Tailscale IP). The bridge port stays on
# 127.0.0.1 by design and is not configurable here.
NOVNC_BIND_LAN=127.0.0.1
NOVNC_BIND_TS=127.0.0.1

# Plain-text password for the noVNC view. Leave empty to fall back to the
# host VNC password file mounted read-only into the container.
VNC_PASSWORD=
